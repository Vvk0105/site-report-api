# Copy to .env and fill in. Never commit the real .env (it is git-ignored).

# Database (asyncpg URL)
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/site_report

# Auth
SECRET_KEY=generate-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin account ensured on every start. The password is set only when the account is created
# or has no password yet; changing this value later does not change an existing password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Email (SMTP). SMTP_SSL=true for implicit TLS (port 465), false for STARTTLS (port 587).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_SSL=false

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test
STRIPE_PUBLISHABLE_KEY=pk_live_or_test
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Apple StoreKit. Apple purchases are rejected until APPLE_ROOT_CA_PATH points to
# "Apple Root CA - G3" (https://www.apple.com/certificateauthority/). Use the downloaded
# AppleRootCA-G3.cer as it is; both .cer (DER) and PEM files work. Put it in ./certs on the server.
APPLE_ROOT_CA_PATH=/app/certs/AppleRootCA-G3.cer
APPLE_BUNDLE_ID=com.netbussinesshub.sitereports

# Browser origins allowed to call the API (comma separated), and the public URLs used for Stripe redirects.
CORS_ORIGINS=https://admin.sitesreports.com,https://sitesreports.com,https://www.sitesreports.com
ADMIN_PUBLIC_URL=https://admin.sitesreports.com
WEB_PUBLIC_URL=https://sitesreports.com

# Uploaded report PDFs larger than this are rejected (bytes).
MAX_REPORT_PDF_BYTES=15728640
